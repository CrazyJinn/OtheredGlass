{
  "meta": {
    "chapter": 0,
    "title": "序章",
    "requires": {
      "characters": ["陆择", "顾盈"],
      "scenes": ["酒店-客房"],
      "portraits": ["陆择.从容", "陆择.玩味", "陆择.紧张", "陆择.周旋", "顾盈.慵懒", "顾盈.挑逗", "顾盈.冷意", "顾盈.笑意"]
    }
  },
  "scenes": [
    {
      "id": "客房清晨",
      "scene": "酒店-客房",
      "time": "清晨",
      "bgm": { "track": "晨光与宿醉", "mode": "play", "loop": true },
      "lines": [
        { "op": "narrate", "text": "宿醉像一层湿棉絮，压在太阳穴上。" },
        { "op": "narrate", "text": "冷白色的晨光从落地窗挤进来，把凌乱的床铺和散落一地的衣物照得无所遁形。" },
        { "op": "narrate", "text": "陆择睁开眼，盯着陌生的天花板，用了三秒才想起自己在哪里——以及，身边本该有人的位置，是空的。" },
        { "op": "narrate", "text": "卫浴区传来水声。片刻后，磨砂玻璃门被推开。" },
        { "op": "show", "who": "顾盈", "portrait": "慵懒", "pos": "right" },
        { "op": "narrate", "text": "顾盈裹着一件明显不合身的白衬衫——那是陆择的——赤脚踩在地毯上，头发半湿，神态却像在自己家一样从容。" },
        { "op": "say", "who": "顾盈", "portrait": "笑意", "pos": "right", "text": "醒了？" },
        { "op": "say", "who": "顾盈", "portrait": "慵懒", "pos": "right", "text": "不急，慢慢来。" },
        { "op": "show", "who": "陆择", "portrait": "从容", "pos": "left" },
        { "op": "say", "who": "陆择", "portrait": "玩味", "pos": "left", "text": "呵，有意思。" },
        { "op": "say", "who": "陆择", "portrait": "从容", "pos": "left", "text": "你这衬衫，穿得比我还合身。" },
        { "op": "say", "who": "顾盈", "portrait": "挑逗", "pos": "right", "text": "是吗。" },
        { "op": "say", "who": "顾盈", "portrait": "笑意", "pos": "right", "text": "昨晚，你可没嫌它不合身。" },
        { "op": "narrate", "text": "空气里浮着一层暧昧的薄雾。陆择在心里迅速盘算——这是个什么样的女人，又该怎么收场。" },
        { "op": "say", "who": "陆择", "portrait": "从容", "pos": "left", "text": "这个嘛……我记性不太好，昨晚的事，得有人帮我回忆回忆。" },
        { "op": "say", "who": "顾盈", "portrait": "挑逗", "pos": "right", "text": "嗯？" },
        { "op": "say", "who": "顾盈", "portrait": "笑意", "pos": "right", "text": "回忆是免费的。再往后，可就要另算了。" },
        { "op": "narrate", "text": "她走到床头柜前，不紧不慢地拿起自己的耳环。每一个动作，都透着一种「我随时可以走」的从容。" },
        { "op": "say", "who": "陆择", "portrait": "玩味", "pos": "left", "text": "你看你，又跟我客气了。" },
        { "op": "say", "who": "陆择", "portrait": "从容", "pos": "left", "text": "这事儿，咱们慢慢聊，不急的。" },
        { "op": "say", "who": "顾盈", "portrait": "冷意", "pos": "right", "text": "谁跟你「咱们」。" },
        { "op": "narrate", "text": "语气还是笑着，笑里却多了一道锋。陆择心里咯噔一下——这女人，不好糊弄。" },
        { "op": "narrate", "text": "床头，手机屏幕亮了一下，又暗下去。陆择的视线飘过去，像抓住了一根现成的稻草。" },
        { "op": "choice", "options": [
          { "label": "手机没电了，得先走一步", "scene": "体面逃离" },
          { "label": "留下来，再试探试探", "scene": "暧昧拉扯" }
        ] }
      ]
    },
    {
      "id": "体面逃离",
      "scene": "酒店-客房",
      "time": "清晨",
      "lines": [
        { "op": "say", "who": "陆择", "portrait": "周旋", "pos": "left", "text": "哎，真是不好意思——我手机一点电都没了。" },
        { "op": "say", "who": "陆择", "portrait": "从容", "pos": "left", "text": "约了人谈点事，再不去就误点了。这事儿，改天我请你喝杯好的？" },
        { "op": "say", "who": "顾盈", "portrait": "笑意", "pos": "right", "text": "是吗。" },
        { "op": "say", "who": "顾盈", "portrait": "冷意", "pos": "right", "text": "走吧。别把我的耐心，当下次的筹码。" },
        { "op": "narrate", "text": "她甚至没抬头看他，只对着镜子把耳环戴好，嘴角那点笑意冷得恰到好处。" },
        { "op": "say", "who": "陆择", "portrait": "玩味", "pos": "left", "text": "呵，那改天见。" },
        { "op": "narrate", "text": "陆择以一种近乎熟练的速度收拾好自己，推门离开。走廊的冷风扑面而来，他才松了口气——也清楚，自己大概率不会再「改天」了。" },
        { "op": "jump", "scene": "收束" }
      ]
    },
    {
      "id": "暧昧拉扯",
      "scene": "酒店-客房",
      "time": "清晨",
      "lines": [
        { "op": "say", "who": "陆择", "portrait": "玩味", "pos": "left", "text": "急什么，手机嘛，晚点充也一样。" },
        { "op": "say", "who": "陆择", "portrait": "从容", "pos": "left", "text": "难得碰上个聊得来的人，这就走了，多没意思。" },
        { "op": "say", "who": "顾盈", "portrait": "挑逗", "pos": "right", "text": "聊得来？" },
        { "op": "say", "who": "顾盈", "portrait": "笑意", "pos": "right", "text": "你连我名字，都未必记得全吧。" },
        { "op": "say", "who": "陆择", "portrait": "周旋", "pos": "left", "text": "这个嘛……顾盈，对吧？让我想想，昨晚你自我介绍的时候，声音挺好听的。" },
        { "op": "say", "who": "顾盈", "portrait": "冷意", "pos": "right", "text": "记性，倒也没那么差。" },
        { "op": "narrate", "text": "她在床沿坐下，隔着半臂的距离，像在丈量什么。窗外的光打在她侧脸上，半真半假。" },
        { "op": "say", "who": "顾盈", "portrait": "慵懒", "pos": "right", "text": "不过，「聊得来」这种话，我听过太多次了。" },
        { "op": "say", "who": "顾盈", "portrait": "挑逗", "pos": "right", "text": "你呢，今晚挺有趣的——哦不对，是今早。" },
        { "op": "say", "who": "陆择", "portrait": "紧张", "pos": "left", "text": "别急，我有数。" },
        { "op": "say", "who": "陆择", "portrait": "从容", "pos": "left", "text": "我不是那种拔腿就忘的人，这你放心。" },
        { "op": "say", "who": "顾盈", "portrait": "笑意", "pos": "right", "text": "放心？" },
        { "op": "say", "who": "顾盈", "portrait": "冷意", "pos": "right", "text": "我最不放心的，就是嘴上说得好看的人。" },
        { "op": "narrate", "text": "她站起身，把那件白衬衫的下摆随意地理了理，像在宣示某种主权，又像在告别。" },
        { "op": "say", "who": "顾盈", "portrait": "慵懒", "pos": "right", "text": "行了。我该走了。" },
        { "op": "say", "who": "顾盈", "portrait": "笑意", "pos": "right", "text": "号码你自己存着吧。用不用，看你。" },
        { "op": "narrate", "text": "一张写着号码的便签被压在床头柜上。门在她身后轻轻合上，留下一室冷下来的晨光，和陆择没说完的半句漂亮话。" },
        { "op": "jump", "scene": "收束" }
      ]
    },
    {
      "id": "收束",
      "scene": "酒店-客房",
      "time": "清晨",
      "lines": [
        { "op": "narrate", "text": "无论哪一种收场，这个清晨都像一面镜子——照出的，是陆择最擅长的那种「得体」。" },
        { "op": "narrate", "text": "只是他还不知道，有些人，不是一句「改天」就能从生命里抹掉的。" },
        { "op": "narrate", "text": "——序章·完——" }
      ]
    }
  ]
}
