MERGE (l:Location {id:'OwNAPmzh1U'})
SET l.description = '灵魂在两段存在之间滞留的过渡空间，以写实古希腊城邦的形态呈现。视觉上是地中海城邦的市井面貌：中央阿哥拉广场被柱廊围合，四周环绕多立克/爱奥尼克柱式的议会厅、市政建筑与作为城市一部分的神庙，石板街道、台阶向民居区延伸，远处山坡上矗立着卫城轮廓，橄榄树和柏树点缀街角。叙事上陆择死后灵魂在此滞留，伊芙以天使灵魂引路人身份现身，告知六个试炼、每个30天、灵魂穿越拯救弱者的规则。';

MERGE (s:Scene {id:'OwNTDArnfs'}) SET s.status = -1;

MERGE (s:Scene {id:'OwNTDArnfs'})
SET s.status = 1,
    s.atmosphere = '古希腊城邦市井日常。阿哥拉广场上人群在集市走动，柱廊下阴凉，议会厅与公共建筑传出公共生活的低语。空气干爽，地中海阳光明亮，橄榄树影婆娑。',
    s.composition = '远景：远处山坡上的卫城轮廓，由神庙与城墙组成；中景：阿哥拉广场中心，被多立克和爱奥尼克柱式的柱廊围合，广场上是集市石板铺地，公共建筑——议会厅、市政厅、作为城市一部分的神庙——沿广场四周排列，平顶灰泥民居在公共建筑后方鳞次栉比；近景：广场边缘的橄榄树和柏树、石板街道、台阶、陶土红屋顶的民居立面，视角为城市中心人视高度。',
    s.lighting = '地中海明亮日光，太阳高悬，自然写实外光。蓝天，柱廊投下规整的阴影，白墙和大理石柱在日光下明亮温暖。',
    s.color_direction = '基底石灰岩白与大理石白，辅色陶土赭石与陶土红用于屋顶和部分墙面，天空为地中海蓝，植被为橄榄绿。整体是地中海城邦写实日光明亮配色。',
    s.art_element = '古希腊城邦 / polis / 阿哥拉广场 / 柱廊 stoa / 多立克柱式 / 爱奥尼克柱式 / 议会厅 / 市政建筑 / 神庙 / 平顶灰泥民居 / 石板街道 / 台阶 / 陶土红屋顶 / 卫城远景 / 橄榄树 / 柏树 / 地中海日光 / 写实 / 落地城市 / 油画风格 / 手绘厚涂质感 / 游戏美术 / 无角色',
    s.description = '写实古希腊城邦形态的灵魂过渡空间。城市中心是阿哥拉广场，被柱廊围合，四周环绕多立克/爱奥尼克柱式的议会厅、市政建筑和作为城市一部分的神庙。石板街道、台阶向民居区延伸，远处山坡上矗立卫城。橄榄树和柏树点缀其间，地中海明亮日光下整体呈现写实的古希腊城邦市井面貌。',
    s.weather = '晴朗，蓝天，地中海明亮日光';

MERGE (sl:SceneLayer {id:'PSuagPde1A'}) SET sl.status = -1;
