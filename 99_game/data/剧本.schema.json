{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otheredglass.local/schema/剧本.schema.json",
  "title": "剧本章节",
  "description": "《他者之镜》剧本章节文件格式 V1。详见 00_init/Schema/剧本.md。",
  "type": "object",
  "required": ["meta", "scenes"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["chapter", "title"],
      "additionalProperties": false,
      "properties": {
        "chapter": { "type": ["integer", "string"] },
        "title": { "type": "string" },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "characters": { "type": "array", "items": { "type": "string" } },
            "scenes": { "type": "array", "items": { "type": "string" } },
            "portraits": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sceneBlock" }
    }
  },
  "$defs": {
    "pos": { "enum": ["left", "center", "right"] },
    "endingKind": { "enum": ["BE", "TE", "HE", "NE"] },
    "bgmBody": {
      "type": "object",
      "required": ["track", "mode"],
      "additionalProperties": false,
      "properties": {
        "track": { "type": "string" },
        "mode": { "enum": ["play", "stop", "fade"] },
        "loop": { "type": "boolean" }
      }
    },
    "jumpTarget": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["to"] },
        { "required": ["scene"] },
        { "required": ["file"] }
      ],
      "properties": {
        "to": { "type": "string" },
        "scene": { "type": "string" },
        "file": { "type": "string" }
      }
    },
    "sceneBlock": {
      "type": "object",
      "required": ["id", "scene", "lines"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "scene": { "type": "string" },
        "time": { "type": "string" },
        "bgm": { "$ref": "#/$defs/bgmBody" },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "line": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "who", "portrait", "pos", "text"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "say" },
            "who": { "type": "string" },
            "portrait": { "type": "string" },
            "pos": { "$ref": "#/$defs/pos" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "text"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "narrate" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "who", "portrait"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "show" },
            "who": { "type": "string" },
            "portrait": { "type": "string" },
            "pos": { "$ref": "#/$defs/pos" }
          }
        },
        {
          "type": "object",
          "required": ["op", "who"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "hide" },
            "who": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "scene"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "bg" },
            "scene": { "type": "string" },
            "time": { "type": "string" },
            "transition": { "enum": ["fade", "cut"] }
          }
        },
        {
          "type": "object",
          "required": ["op", "track", "mode"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "bgm" },
            "track": { "type": "string" },
            "mode": { "enum": ["play", "stop", "fade"] },
            "loop": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["op", "track"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "sfx" },
            "track": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "options"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "choice" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/choiceOption" }
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "name"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "label" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "allOf": [
            {
              "anyOf": [
                { "required": ["to"] },
                { "required": ["scene"] },
                { "required": ["file"] }
              ]
            }
          ],
          "properties": {
            "op": { "const": "jump" },
            "to": { "type": "string" },
            "scene": { "type": "string" },
            "file": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "kind"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "ending" },
            "kind": { "$ref": "#/$defs/endingKind" },
            "title": { "type": "string" },
            "cg": { "type": "string" }
          }
        }
      ]
    },
    "choiceOption": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["to"] },
        { "required": ["scene"] },
        { "required": ["file"] }
      ],
      "properties": {
        "label": { "type": "string" },
        "to": { "type": "string" },
        "scene": { "type": "string" },
        "file": { "type": "string" },
        "leads_to_ending": { "type": "boolean" }
      }
    }
  }
}
