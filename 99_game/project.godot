; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="他者之镜"
run/main_scene="res://scenes/Title.tscn"
; 统一用 GL Compatibility：Galgame 不吃高级渲染，且 Web 端只支持此渲染器；桌面/移动端共用，省维护。
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
ScriptInterpreter="*res://scripts/autoload/ScriptInterpreter.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
; 章节资源包下载挂载层（Web 分包地基；桌面端 no-op）
ChapterPackLoader="*res://scripts/autoload/ChapterPackLoader.gd"

[display]

window/size/viewport_width=1536
window/size/viewport_height=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="他者之镜"
